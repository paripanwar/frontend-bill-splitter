<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bill Splitter 💸</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Patrick+Hand&display=swap');

*{box-sizing:border-box}
body{
  margin:0; min-height:100vh; color:#34405c;
  font-family:"DM Sans",sans-serif;
  background-color:#f8f6ff;
  background-image:
    linear-gradient(90deg,rgba(181,171,230,.15) 1px,transparent 1px),
    linear-gradient(rgba(181,171,230,.15) 1px,transparent 1px);
  background-size:28px 28px;
}
.wrapper{max-width:1120px;margin:auto;padding:38px 22px 28px}
.hero{text-align:center;margin-bottom:28px}
.doodles{font-size:30px;letter-spacing:10px}
h1{font-size:clamp(42px,7vw,68px);margin:2px 0 0;letter-spacing:-2px;color:#29324d}
.tagline{font:28px "Patrick Hand",cursive;color:#747b96;margin:0}
.layout{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.card{
  background:rgba(255,255,255,.92);border:1px solid rgba(120,110,170,.14);
  border-radius:28px;padding:30px;box-shadow:0 18px 45px rgba(65,55,110,.10)
}
.result{background:rgba(241,251,247,.94)}
h2{margin:0 0 24px;font-size:25px}
.field{margin-bottom:19px}
label{display:block;font-weight:700;color:#53607b;margin-bottom:8px}
input{
  width:100%;padding:15px 16px;border:2px solid #e3e0eb;border-radius:15px;
  outline:none;font:16px "DM Sans";background:#fff;color:#35405a
}
input:focus{border-color:#aaa0e6;box-shadow:0 0 0 4px rgba(170,160,230,.15)}
.split-label{margin:22px 0 9px;color:#59617a;font-weight:700}
.methods{display:flex;border:2px solid #e4e1eb;border-radius:15px;padding:4px;background:#fff}
.method{flex:1;text-align:center;padding:11px;border-radius:11px;cursor:pointer;color:#69718a}
.method.active{background:#eeeaff;color:#756bc4;font-weight:700}
.method input{display:none}
button{
  width:100%;border:0;border-radius:16px;padding:15px;margin-top:20px;
  background:#aaa0e6;color:#fff;font:700 17px "DM Sans";cursor:pointer;
  transition:.2s;box-shadow:0 7px 16px rgba(120,105,190,.2)
}
button:hover{background:#9589d8;transform:translateY(-1px)}
.summary{background:rgba(255,255,255,.65);border-radius:20px;padding:4px 15px}
.row{display:flex;justify-content:space-between;padding:17px 4px;border-bottom:1px solid rgba(90,90,120,.1)}
.row:last-child{border:0}
.row strong{color:#34405c}
.total{margin-top:13px;padding:17px;border-radius:18px;background:#fff8e8;display:flex;justify-content:space-between;font-weight:600}
.total strong{font-size:20px;color:#397b70}
.each{margin-top:18px;text-align:center;padding:22px;border-radius:20px;background:#eeeaff}
.each small{font-size:16px}.amount{font-size:45px;font-weight:700;color:#343b63;margin-top:3px}
.note{margin-top:17px;text-align:center;background:#fff3dc;border-radius:17px;padding:12px;font:20px "Patrick Hand";color:#62687b}
.footer{text-align:center;font:20px "Patrick Hand";color:#8a8fa4;margin-top:24px}
.error{color:#b05b65;font-size:13px;margin-top:8px;display:none}
@media(max-width:760px){.layout{grid-template-columns:1fr}.wrapper{padding-top:24px}.card{padding:23px}.result{min-height:auto}}
</style>
</head>
<body>
<div class="wrapper">
  <header class="hero">
    <div class="doodles">💸 ✦ 🧾</div>
    <h1>Bill Splitter</h1>
    <p class="tagline">Simple. Fair. Together. ♡</p>
  </header>

  <main class="layout">
    <section class="card">
      <h2>Enter Bill Details</h2>

      <div class="field">
        <label for="bill">💰 Total Bill Amount (₹)</label>
        <input id="bill" type="number" min="0" step="0.01" placeholder="e.g. 2400" value="2400">
        <div class="error" id="billError">Please enter a valid bill amount.</div>
      </div>

      <div class="field">
        <label for="people">👥 Number of People</label>
        <input id="people" type="number" min="1" step="1" placeholder="e.g. 4" value="4">
        <div class="error" id="peopleError">There must be at least 1 person.</div>
      </div>

      <div class="field">
        <label for="tip">％ Tip Percentage (optional)</label>
        <input id="tip" type="number" min="0" max="100" step="1" placeholder="e.g. 10" value="10">
        <div class="error" id="tipError">Tip must be between 0% and 100%.</div>
      </div>

      <div class="split-label">Split Method</div>
      <div class="methods">
        <label class="method active" id="equalLabel">
          <input type="radio" name="method" value="equal" checked> 👥 Equal Split
        </label>
        <label class="method" id="customLabel">
          <input type="radio" name="method" value="custom"> 👤 Custom Split
        </label>
      </div>

      <button id="calculate">🧮 Calculate Bill &nbsp; →</button>
    </section>

    <section class="card result">
      <h2>✨ Bill Summary</h2>
      <div class="summary">
        <div class="row"><span>💰 &nbsp; Total Bill</span><strong id="outBill">₹2,400.00</strong></div>
        <div class="row"><span>👥 &nbsp; People</span><strong id="outPeople">4</strong></div>
        <div class="row"><span>％ &nbsp; Tip (<span id="outTipPct">10</span>%)</span><strong id="outTip">₹240.00</strong></div>
      </div>
      <div class="total"><span>✨ &nbsp; Grand Total</span><strong id="outTotal">₹2,640.00</strong></div>
      <div class="each">
        <small>👤 Each person pays</small>
        <div class="amount" id="outEach">₹660.00</div>
      </div>
      <div class="note">Good food tastes better when it's shared! ♡</div>
    </section>
  </main>

  <div class="footer">— &nbsp; Split • Share • Enjoy &nbsp; —</div>
</div>

<script>
const bill = document.getElementById("bill");
const people = document.getElementById("people");
const tip = document.getElementById("tip");

function money(n){
  return "₹" + n.toLocaleString("en-IN",{minimumFractionDigits:2,maximumFractionDigits:2});
}
function calculate(){
  const b = Number(bill.value), p = Number(people.value), t = Number(tip.value);
  document.querySelectorAll(".error").forEach(e=>e.style.display="none");
  let valid=true;
  if(!Number.isFinite(b) || b<0){document.getElementById("billError").style.display="block";valid=false}
  if(!Number.isInteger(p) || p<1){document.getElementById("peopleError").style.display="block";valid=false}
  if(!Number.isFinite(t) || t<0 || t>100){document.getElementById("tipError").style.display="block";valid=false}
  if(!valid)return;
  const tipAmount=b*t/100, total=b+tipAmount, each=total/p;
  document.getElementById("outBill").textContent=money(b);
  document.getElementById("outPeople").textContent=p;
  document.getElementById("outTipPct").textContent=t;
  document.getElementById("outTip").textContent=money(tipAmount);
  document.getElementById("outTotal").textContent=money(total);
  document.getElementById("outEach").textContent=money(each);
}
document.getElementById("calculate").addEventListener("click",calculate);

document.querySelectorAll('input[name="method"]').forEach(r=>{
  r.addEventListener("change",()=>{
    document.getElementById("equalLabel").classList.toggle("active",r.value==="equal" && r.checked);
    document.getElementById("customLabel").classList.toggle("active",r.value==="custom" && r.checked);
    if(r.value==="custom" && r.checked){
      alert("Custom Split is coming soon! Equal Split is active right now. ♡");
      document.querySelector('input[value="equal"]').checked=true;
      document.getElementById("equalLabel").classList.add("active");
      document.getElementById("customLabel").classList.remove("active");
    }
  });
});
</script>
</body>
</html>
